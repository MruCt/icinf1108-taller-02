# Plantilla de configuración local (.env)
POSTGRES_USER=usuario_ejemplo
POSTGRES_PASSWORD=clave_ejemplo
POSTGRES_DB=basedata_t2
DATABASE_URL=postgresql://usuario_ejemplo:clave_ejemplo@db:5432/basedata_t2